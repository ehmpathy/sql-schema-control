exports[`cli.acceptance given: [case1] --help flag when: [t0] bin/run is called with --help then: it should show help and exit 0 1`] = `
"Usage: sql-schema-control [options] [command]

Declarative database schema management. Provision, track, sync, and modify your
database schema with plain, version controlled, sql.

Options:
  -V, --version    output the version number
  -h, --help       display help for command

Commands:
  plan [options]   generate and show an execution plan
  apply [options]  apply an execution plan
  sync [options]   sync the change log for a specific change definition without
                   applying it, for cases where a change has been reapplied
                   manually
  pull [options]   pull and record uncontrolled resources
  help [command]   display help for command
"
`;

